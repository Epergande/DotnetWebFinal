@model IEnumerable<Discount>

<a asp-controller="Product" asp-action="AddDiscount" class="btn btn-primary">Add A New discount</a>

<table class="table table-hover ">
  <thead>
    <tr>
      <th scope="col">Discount title</th>
      <th scope="col">edit</th>
      <th scope="col" class="text-end">Percent</th>
      <th scope="col" class="text-end">Start date</th>
      <th scope="col" class="text-end">End date</th>

    </tr>
</thead>
<tbody>
  @foreach (Discount p in Model)
  {
    <tr>
      <td>@p.Title</td>
      <td> <a asp-controller="Product" asp-action="EditDiscount" asp-route-id="@p.DiscountId" >Edit</a> </td>
      <td class="text-end">@string.Format("{0:P}", p.DiscountPercent)</td>
      <td class="text-end">@p.StartTime.ToString("MMMM dd, yyyy")</td>
      <td class="text-end">@p.EndTime.ToString("MMMM dd, yyyy")</td>
    </tr>
  }
  </tbody>
</table>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go Home</a>