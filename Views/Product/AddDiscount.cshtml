@model Discount
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="page-wrapper bg-gra-02 p-t-130 p-b-100 font-poppins">
        <div class="wrapper wrapper--w680">
            <div class="card card-4">
                <div class="card-body">
                    
                    <h2 class="title">Add Discount</h2>
                    <form  method="POST">
                        <div asp-validation-summary="All"></div>
                        <div class="row row-space">
                            <div class="col-2">
                                <div class="input-group">
                                    <label asp-for="@Model.Title" class="label">Discount Title</label>
                                    <input asp-for="@Model.Title" class="input--style-4" type="text" >
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="input-group">
                                    <label asp-for="@Model.DiscountPercent" class="label">Discount Percent</label>
                                    <input asp-for="@Model.DiscountPercent" class="input--style-4" type="number" >
                                </div>
                            </div>
                        </div>
                        <div class="row row-space">
                            <div class="col-2">
                                <div class="input-group">
                                    <label asp-for="@Model.StartTime"class="label">Start Date</label>
                                    <div class="input-group-icon">
                                        <input asp-for="@Model.StartTime"class="input--style-4 js-datepicker" type="date" 
                                        ">
                                        <i class="zmdi zmdi-calendar-note input-icon js-btn-calendar"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="input-group">
                                    <label asp-for="@Model.EndTime"classclass="label">End Date</label>
                                    <div class="input-group-icon">
                                        <input asp-for="@Model.EndTime"class="input--style-4 js-datepicker" type="date" 
                                         ">
                                        <i class="zmdi zmdi-calendar-note input-icon js-btn-calendar"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                  
                        <div class="row row-space">
                            <div class="col-2">
                                <div class="input-group">
                                    <label asp-for="@Model.ProductId" class="label">Product ID</label>
                                    <input asp-for="@Model.ProductId" class="input--style-4" type="text" >
                                </div>
                            </div>
                         
                        </div>
                     
                   
                        <div class="p-t-15">
                            <button  class="btn btn--radius-2 btn--blue" type="submit" >Submit</button>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>